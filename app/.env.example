# Copy to app/.env.local to point the dashboard at another Mezo testnet vault.
# Without these the dashboard shows the demo vault.
# VITE_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
# VITE_DEPLOY_BLOCK=0
# VITE_RPC_URL=http://127.0.0.1:8545   # a local fork of Mezo testnet, for tests only (its price feed needs a mock)
# Local wallet test, see scripts/local-wallet/start.sh. Offered only when the RPC and the page are both on this machine.
# VITE_TEST_WALLET_ACCOUNTS=0xOwnerAddress,0xOperatorAddress
# VITE_TEST_WALLET_WRONG_CHAIN=1
# WalletConnect (mobile wallets) needs a project ID from cloud.reown.com. Without it the dialog lists browser wallets.
# VITE_WALLETCONNECT_PROJECT_ID=
